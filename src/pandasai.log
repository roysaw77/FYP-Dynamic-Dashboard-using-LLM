import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Query the relevant table from the database
sql_query = """
SELECT IDOrganisation, Address, State, District, lat, lng, TotalRevenue, TotalPaid, TotalPanel, 
   TotalPaidPatientCount, TotalPanelPatientCount, PatientCount, NewPatientCount, ReturnPatientCount, 
   TotalCash, TotalCheque, TotalElectronic, TotalCashPatientCount, TotalChequePatientCount, 
   TotalElectronicPatientCount
FROM table_bd4f8d5ffa8239c09831e5b997bc2753
"""
df = execute_sql_query(sql_query)

# Ensure numeric types for analysis columns
df['TotalRevenue'] = pd.to_numeric(df['TotalRevenue'], errors='coerce')
df['PatientCount'] = pd.to_numeric(df['PatientCount'], errors='coerce')

# Linear regression: TotalRevenue = slope * PatientCount + intercept
# This models how revenue changes with patient count
x = df['PatientCount'].values
y = df['TotalRevenue'].values
mask = ~(pd.isna(x) | pd.isna(y))
x_clean = x[mask]
y_clean = y[mask]

if len(x_clean) > 1:
    coeffs = np.polyfit(x_clean, y_clean, 1)
    slope = coeffs[0]
    intercept = coeffs[1]
    predicted_y = slope * x_clean + intercept
    residuals = y_clean - predicted_y  # positive = earn more than trend predicts
else:
    slope = 0
    intercept = 0
    predicted_y = np.array([])
    residuals = np.array([])

# Map regression results back to the full dataframe
df['predicted_TotalRevenue'] = np.nan
df['residual'] = np.nan
valid_mask = ~pd.isna(df['PatientCount']) & ~pd.isna(df['TotalRevenue'])
df.loc[valid_mask, 'predicted_TotalRevenue'] = predicted_y
df.loc[valid_mask, 'residual'] = residuals

# Identify clinics with the most extreme residuals (much more or much less than trend)
if not df['residual'].dropna().empty:
    min_res_idx = df['residual'].idxmin()
    max_res_idx = df['residual'].idxmax()
else:
    min_res_idx = max_res_idx = None

# Plot PatientCount against TotalRevenue with a trend line and highlight outliers
plt.figure(figsize=(10, 6))
plt.scatter(df['TotalRevenue'], df['PatientCount'], s=100, color='steelblue', 
            edgecolor='black', zorder=5, label='Clinics')

# Trend line expressed in the plot orientation (PatientCount vs TotalRevenue)
# From TotalRevenue = slope * PatientCount + intercept  =>  PatientCount = (TotalRevenue - intercept) / slope
if not np.isnan(slope) and slope != 0:
    x_trend = np.array([df['TotalRevenue'].min(), df['TotalRevenue'].max()])
    y_trend = (x_trend - intercept) / slope
    plt.plot(x_trend, y_trend, color='red', linewidth=2, linestyle='--', 
             label='Trend line (TotalRevenue ~ PatientCount)', zorder=3)

# Highlight clinics earning much more or much less than the trend predicts
for idx in df.index:
    if not pd.isna(df.loc[idx, 'residual']):
        org = df.loc[idx, 'IDOrganisation']
        res = df.loc[idx, 'residual']
        is_extreme = (idx == min_res_idx) or (idx == max_res_idx)
        if is_extreme:
            plt.annotate(f"{org}\n(residual: {res:.0f})",
                         (df.loc[idx, 'TotalRevenue'], df.loc[idx, 'PatientCount']),
                         color='darkred', fontsize=8, fontweight='bold',
                         xytext=(0, 12), textcoords='offset points',
                         bbox=dict(boxstyle='round,pad=0.3', facecolor='white', 
                                   edgecolor='darkred', alpha=0.8))
        else:
            plt.text(df.loc[idx, 'TotalRevenue'], df.loc[idx, 'PatientCount'], org,
                     fontsize=7, ha='center', va='bottom', color='navy')

plt.xlabel('Total Revenue')
plt.ylabel('Patient Count')
plt.title('Patient Count vs Total Revenue with Trend Line')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('temp_chart.png')
plt.close()

# Declare result variable as specified
result = { "type": "plot", "value": "temp_chart.png" }
