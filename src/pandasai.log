# TODO: import the required dependencies
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Write code here
# Execute SQL query to fetch the relevant columns, sorted by PatientCount for consistent plotting
sql_query = "SELECT IDOrganisation, PatientCount, TotalRevenue FROM table_bd4f8d5ffa8239c09831e5b997bc2753 ORDER BY PatientCount"
df = execute_sql_query(sql_query)

# --- Compute linear regression trend line ---
x = df['PatientCount'].values
y = df['TotalRevenue'].values
slope, intercept = np.polyfit(x, y, 1)          # y = slope*x + intercept
y_pred = slope * x + intercept
residuals = y - y_pred                           # actual - predicted

# --- Identify clinics that earn much more or much less than the trend predicts ---
# Threshold: absolute residual > 10% of the total revenue range
rev_range = y.max() - y.min()
threshold = 0.10 * rev_range
highlight_mask = np.abs(residuals) > threshold

# --- Plot PatientCount vs TotalRevenue with trend line ---
plt.figure(figsize=(10, 6))
plt.scatter(x, y, color='steelblue', s=80, edgecolor='white', label='Clinics')
plt.plot(x, y_pred, color='darkred', linewidth=2, linestyle='-', label='Trend line')

# Highlight outlier clinics
if highlight_mask.any():
    for i in np.where(highlight_mask)[0]:
        row = df.iloc[i]
        res = residuals[i]
        # Annotate clinic name with color-coded direction
        color = 'darkgreen' if res > 0 else 'orange'
        plt.annotate(row['IDOrganisation'],
                     (row['PatientCount'], row['TotalRevenue']),
                     textcoords="offset points", xytext=(0, 12), ha='center',
                     fontsize=9, fontweight='bold', color=color)
        # Plot highlighted point slightly larger
        plt.scatter(row['PatientCount'], row['TotalRevenue'], 
                    color=color, s=130, zorder=5, edgecolor='black')

plt.title('PatientCount vs TotalRevenue with Trend Line', fontsize=14)
plt.xlabel('PatientCount', fontsize=12)
plt.ylabel('TotalRevenue', fontsize=12)
plt.legend(fontsize=10)
plt.grid(True, alpha=0.3)
plt.tight_layout()

# --- Save plot to a temporary file ---
plot_path = '/tmp/patient_revenue_trend.png'
plt.savefig(plot_path, dpi=100, bbox_inches='tight')
plt.close()

# --- Declare result variable ---
result = {
    "type": "plot",
    "value": plot_path
}
