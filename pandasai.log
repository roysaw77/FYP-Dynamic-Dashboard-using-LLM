# Import the required dependencies
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Get the top 5 high patient count doctors working in clinics with highest revenue
sql_query = """
WITH clinic_revenue AS (
    SELECT
        t1.IDOrganisation,
        t1.TotalRevenue,
        t2.StaffName,
        t2.TotalPatientCount,
        t2.TotalPaidPatientCount,
        t2.TotalPanelPatientCount
    FROM
        table_bd4f8d5ffa8239c09831e5b997bc2753 t1
    JOIN
        table_c83679f393c19ab82f71054c6c3facb6 t2
    ON
        t1.IDOrganisation = t2.IDOrganisation
    WHERE
        t2.Locum/Residence = 'Residence'
)
SELECT
    StaffName,
    TotalPatientCount,
    TotalRevenue
FROM
    clinic_revenue
ORDER BY
    TotalRevenue DESC,
    TotalPatientCount DESC
LIMIT 5
"""

# Execute the query
top_doctors_df = execute_sql_query(sql_query)

# Create the plot
