plt.bar(df['StaffName'], df['TotalPatients'])
plt.xlabel("Doctor Name")
plt.ylabel("Total Patient Count")
plt.title("Top 5 Doctors with Highest Patient Count in Highest Revenue Clinic")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
